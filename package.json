{
  "name": "dsh-contract-suite",
  "version": "0.1.NaN.9",
  "description": "One-command install for dsh-legal-intake and dsh-legal-clause.",
  "type": "module",
  "license": "Apache-2.0",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input/profile.json",
      "prompt": "帮我装好合同法务两件套（合同录入、条款审查），确认两个成员包都能解析，并列出各自版本。",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "samples/quickstart/input/profile.json（合成 profile dump）与本包 cordis.patch.yml、package.json"
      ],
      "writes": [],
      "network": false,
      "external": []
    },
    "capabilities": [],
    "labels": []
  },
  "scripts": {
    "quickstart": "node samples/quickstart/run.mjs",
    "test": "node --test test/suite.test.mjs",
    "gate": "node scripts/gate.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=24.9.0 <25"
  },
  "files": [
    "cordis.patch.yml",
    "src",
    "samples",
    "README.md",
    "LICENSE",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "docs/assets",
    "SECURITY.md",
    "PRIVACY.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SUITE.md",
    "TROUBLESHOOTING.md",
    "screenshots.json",
    "icon.svg"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "perrylink",
    "suite",
    "legal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-contract-suite.git"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/packages/dsh-contract-suite.html",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-contract-suite/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-legal-intake": "0.1.0-alpha.10",
    "dsh-legal-clause": "0.1.0-alpha.12"
  },
  "icon": "icon.svg"
}
